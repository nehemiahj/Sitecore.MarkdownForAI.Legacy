<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sitecore 8.0 to 10.0 (MVC). Compiled against the 8.0 assemblies, the oldest supported release;
    newer releases bind to it through their own assembly redirects.
    Sitecore and ASP.NET MVC references are compile-time only; the site supplies them at runtime.
    Sitecore 10.1 and later: see the Sitecore.MarkdownForAI repository.
  -->
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Sitecore.MarkdownForAI</RootNamespace>
    <AssemblyName>Sitecore.MarkdownForAI</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Nehemiah Jeyakumar</Authors>
    <PackageId>Sitecore.MarkdownForAI.Legacy</PackageId>
    <Description>Serve Sitecore MVC and WebForms pages as clean Markdown for AI agents (/page.md, llms.txt) with component-level control. Sitecore 8.0 to 10.0. The assembly only: the config and items come from the Sitecore package or the files zip.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sitecore;mvc;webforms;markdown;llms.txt;ai</PackageTags>
    <PackageProjectUrl>https://github.com/nehemiahj/Sitecore.MarkdownForAI.Legacy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nehemiahj/Sitecore.MarkdownForAI.Legacy</RepositoryUrl>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <SitecoreVersion>8.0.141212</SitecoreVersion>
    <AspNetMvcVersion>5.1.0</AspNetMvcVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sitecore.Kernel.NoReferences" Version="$(SitecoreVersion)" PrivateAssets="all" />
    <PackageReference Include="Sitecore.Mvc.NoReferences" Version="$(SitecoreVersion)" PrivateAssets="all" />
    <PackageReference Include="Sitecore.ContentSearch.NoReferences" Version="$(SitecoreVersion)" PrivateAssets="all" />
    <PackageReference Include="Sitecore.ContentSearch.Linq.NoReferences" Version="$(SitecoreVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="$(AspNetMvcVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
