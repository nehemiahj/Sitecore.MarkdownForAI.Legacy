<?xml version="1.0" encoding="utf-8"?>
<!--
  Creates the module's items in the master database at startup if they are missing:
    /sitecore/templates/Modules/Markdown For AI/_LlmsPage
    /sitecore/templates/Modules/Markdown For AI/_MarkdownRenderingParameters
    /sitecore/system/Modules/Markdown For AI/Modes/include|exclude
  Idempotent and never overwrites edits. Publish the items afterwards. On servers without a master database
  (content delivery) the installer does nothing, so this file is safe to deploy everywhere. Once they are in your
  serialization (Unicorn, TDS or a package), set MarkdownForAI.InstallItems to false.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/">
  <sitecore>
    <settings>
      <setting name="MarkdownForAI.InstallItems" value="true" />
    </settings>
    <pipelines>
      <initialize>
        <processor type="Sitecore.MarkdownForAI.Install.InstallItems, Sitecore.MarkdownForAI" />
      </initialize>
    </pipelines>
  </sitecore>
</configuration>
